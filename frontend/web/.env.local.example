# FairProcess Frontend Environment

# API URL (backend API — use local for dev, Cloudflare URL for prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<set-your-anon-key>

# MapLibre (optional — falls back to built-in dark CARTO style)
# NEXT_PUBLIC_MAPLIBRE_STYLE=https://your-style-url.json
