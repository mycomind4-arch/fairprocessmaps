# FairProcessMaps Frontend Environment

# API URL (legacy/local backend reference; production API routes are served by Next.js/Cloudflare)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<set-your-anon-key>

# MapLibre (optional — falls back to built-in dark CARTO style)
# NEXT_PUBLIC_MAPLIBRE_STYLE=https://your-style-url.json

# MailMyPDF service integration
MAILMYPDF_API_URL=https://mycomind4-arch-mailmypdf.mailmypdf.workers.dev
# Store the API key as a Cloudflare secret in production; do not commit it.
MAILMYPDF_API_KEY=<cloudflare-secret>
