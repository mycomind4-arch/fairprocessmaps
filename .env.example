# ─────────────────────────────────────────────
# FairProcess 2.0 Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and adjust values. Required for docker-compose.

# ─── Database ───
POSTGRES_PASSWORD=<set-your-password>

# ─── Neo4j ───
NEO4J_PASSWORD=<set-your-password>

# ─── Meilisearch ───
MEILI_MASTER_KEY=<set-your-key>

# ─── MinIO ───
MINIO_PASSWORD=<set-your-password>

# ─── Auth ───
JWT_SECRET=<set-your-jwt-secret>

# ─── AI APIs (at least one required for extraction) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Supabase (optional, for hosted auth) ───
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Frontend ───
# These are set in docker-compose; for local dev, copy to frontend/web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json

# ── Physical mail (Lob) ──────────────────────────────────────────────────────
# Used by the notice-response workflow to send certified responses to agencies.
# Start with a test_ key: it exercises the entire send path — address
# verification, letter creation, tracking — without mailing anything or
# charging anything. Move to a live_ key only after watching a test letter
# through the whole flow.
#
# Certified mail with return receipt is the default class. First-class is
# cheaper and worthless in a dispute about whether a response was served.
LOB_API_KEY=test_your_key_here
# LOB_API_URL=https://api.lob.com/v1
