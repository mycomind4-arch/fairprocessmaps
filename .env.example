# ─────────────────────────────────────────────
# FairProcess 2.0 Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and adjust values. Required for docker-compose.

# ─── Database ───
POSTGRES_PASSWORD=fp_dev

# ─── Neo4j ───
NEO4J_PASSWORD=fp_dev

# ─── Meilisearch ───
MEILI_MASTER_KEY=fp_dev_key

# ─── MinIO ───
MINIO_PASSWORD=fp_dev_secret

# ─── Auth ───
JWT_SECRET=fp_dev_jwt

# ─── AI APIs (at least one required for extraction) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Supabase (optional, for hosted auth) ───
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Frontend ───
# These are set in docker-compose; for local dev, copy to frontend/web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
