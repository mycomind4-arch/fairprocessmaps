# ─────────────────────────────────────────────
# FairProcess 2.0 Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and adjust values. Required for docker-compose.
#
# NOTE: The production stack is Cloudflare Workers + D1 + R2.
# See docs/architecture/adr.md → ADR-006 for the full rationale.
# The Python microservices stack (PostGIS, Neo4j, Temporal, Meilisearch,
# MinIO, FastAPI) is frozen reference code in backend/ — not deployed.

# ─── AI APIs (optional — used by extraction/analysis agents) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Bootstrap (one-time admin setup) ───
BOOTSTRAP_TOKEN=

# ─── Cloudflare (set in wrangler.toml, not here) ───
# D1 database binding: env.DB
# R2 bucket binding: env.EVIDENCE_BUCKET
# These are configured in frontend/web/wrangler.toml — not env vars.

# ─── Frontend (optional, for local dev without wrangler) ───
# NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
