FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq-dev gdal-bin libgdal-dev \
    tesseract-ocr tesseract-ocr-eng \
    poppler-utils libmagic1 \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /uvx /bin/

COPY workers/pyproject.toml ./
COPY workers/uv.lock* ./
RUN if [ -f uv.lock ]; then uv sync --frozen; else uv sync; fi

COPY workers/src ./src
COPY ai/src ./ai
COPY ingestion/src ./ingestion
COPY shared ./shared

ENV PYTHONPATH=/app/src:/app/ai:/app/ingestion:/app/shared

CMD ["uv", "run", "python", "-m", "src.main"]
