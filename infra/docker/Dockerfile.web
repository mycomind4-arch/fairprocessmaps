FROM node:22-alpine

WORKDIR /app

RUN npm install -g pnpm

COPY package.json ./
# If lockfile exists use frozen, otherwise plain install
COPY pnpm-lock.yaml* ./
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
EXPOSE 3000

# Production build
RUN pnpm build

CMD ["pnpm", "start"]
